---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="relative py-24 bg-gradient-to-br from-sky-50 via-white to-yellow-50 overflow-hidden">
    <div class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 bg-sky-200/40 rounded-full blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-24 w-96 h-96 bg-yellow-200/40 rounded-full blur-3xl"></div>

    <div class="container mx-auto px-6 relative">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Get In <span class="text-sky-400">Touch</span>
        </h1>
        <p class="text-lg text-gray-600">
          Questions about our services or ready to book a meet-and-greet?
          Send us a message and we'll get back to you shortly.
        </p>
      </div>

      <div class="max-w-xl mx-auto bg-white/90 backdrop-blur-sm rounded-2xl shadow-xl border border-gray-100 p-8 md:p-10">
        <div data-fs-success class="mb-6 rounded-lg bg-green-50 border border-green-200 text-green-700 px-4 py-3 text-sm font-medium"></div>
        <div data-fs-error class="mb-6 rounded-lg bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm font-medium"></div>

        <form id="contactForm" method="POST" action="https://formspree.io/f/xwlejaky" class="space-y-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-gray-700 mb-1.5">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Your full name"
                data-fs-field
                class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-sky-400 transition"
              />
              <span data-fs-error="name" class="block text-sm text-red-600 mt-1"></span>
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">Email</label>
              <input
                type="email"
                id="email"
                name="_replyto"
                required
                placeholder="you@example.com"
                data-fs-field
                class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-sky-400 transition"
              />
              <span data-fs-error="_replyto" class="block text-sm text-red-600 mt-1"></span>
            </div>
          </div>

          <div>
            <label for="subject" class="block text-sm font-semibold text-gray-700 mb-1.5">Subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              placeholder="What's this about?"
              data-fs-field
              class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-sky-400 transition"
            />
            <span data-fs-error="subject" class="block text-sm text-red-600 mt-1"></span>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-gray-700 mb-1.5">Message</label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="Tell us about your pup..."
              data-fs-field
              class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-sky-400 transition resize-none"
            ></textarea>
            <span data-fs-error="message" class="block text-sm text-red-600 mt-1"></span>
          </div>

          <button
            type="submit"
            data-fs-submit-btn
            class="w-full bg-sky-400 hover:bg-yellow-400 text-white font-bold py-3 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </main>

  <script>
    import { initForm } from "@formspree/ajax";

    initForm({ formElement: "#contactForm", formId: "xwlejaky" });
  </script>

  <style>
    [data-fs-success]:empty,
    [data-fs-error]:empty {
      display: none;
    }
  </style>
</Layout>
