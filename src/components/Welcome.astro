        />
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="bg-sky-400 text-white py-16">
  <div class="container mx-auto px-6 text-center">
    <h2 class="text-3xl font-bold mb-6">
      Ready to give your dog the <span class="text-pink-300">pawfect</span> care?
    </h2>
    <p class="text-xl mb-8 max-w-2xl mx-auto">
      Schedule a free meet-and-greet to see if we're the right fit for your
      furry family member.
    </p>
    <button
      class="bg-pink-300 text-white hover:bg-transparent font-bold py-3 px-8 rounded-lg shadow-lg transition duration-300"
      >Get Started</button
    >
  </div>
</section>

<!-- Contact Section -->
<section id="contact" class="relative py-24 bg-gradient-to-br from-sky-50 via-white to-pink-50 overflow-hidden">
  <div class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 bg-sky-200/40 rounded-full blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 -left-24 w-96 h-96 bg-pink-200/40 rounded-full blur-3xl"></div>

  <div class="container mx-auto px-6 relative">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Let's Talk About Your <span class="text-sky-400">Pup</span>
      </h2>
      <p class="text-lg text-gray-600">
        Have a question or ready to book a meet-and-greet? Send us a message
        and we'll get back to you shortly.
      </p>
    </div>

    <div class="max-w-xl mx-auto bg-white/90 backdrop-blur-sm rounded-2xl shadow-xl border border-gray-100 p-8 md:p-10">
      <div data-fs-success class="mb-6 rounded-lg bg-green-50 border border-green-200 text-green-700 px-4 py-3 text-sm font-medium"></div>
      <div data-fs-error class="mb-6 rounded-lg bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm font-medium"></div>

      <form id="homeContactForm" method="POST" action="https://formspree.io/f/xwlejaky" class="space-y-5">
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="home-name" class="block text-sm font-semibold text-gray-700 mb-1.5">Name</label>
            <input
              type="text"
              id="home-name"
              name="name"
              required
              placeholder="Your full name"
              data-fs-field
              class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-sky-400 transition"
            />
            <span data-fs-error="name" class="block text-sm text-red-600 mt-1"></span>
          </div>
          <div>
            <label for="home-email" class="block text-sm font-semibold text-gray-700 mb-1.5">Email</label>
            <input
              type="email"
              id="home-email"
              name="_replyto"
              required
              placeholder="you@example.com"
              data-fs-field
              class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-sky-400 transition"
            />
            <span data-fs-error="_replyto" class="block text-sm text-red-600 mt-1"></span>
          </div>
        </div>

        <div>
          <label for="home-message" class="block text-sm font-semibold text-gray-700 mb-1.5">Message</label>
          <textarea
            id="home-message"
            name="message"
            required
            rows="4"
            placeholder="Tell us about your pup..."
            data-fs-field
            class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-sky-400 transition resize-none"
          ></textarea>
          <span data-fs-error="message" class="block text-sm text-red-600 mt-1"></span>
        </div>

        <button
          type="submit"
          data-fs-submit-btn
          class="w-full bg-sky-400 hover:bg-pink-400 text-white font-bold py-3 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  import { initForm } from "@formspree/ajax";

  initForm({ formElement: "#homeContactForm", formId: "xwlejaky" });
</script>

<style>
  :root {
    --primary: #6d28d9;
    --primary-light: #8b5cf6;
  }
  body {
    font-family: "Space Grotesk", sans-serif;
    background-color: #faf5ff;
  }
  .gradient-bg {
    background: linear-gradient(135deg, #d5e1ff 0%, #136cf3 100%);
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  .float-animation {
    animation: float 3s ease-in-out infinite;
  }
  [data-fs-success]:empty,
  [data-fs-error]:empty {
    display: none;
  }
</style>
