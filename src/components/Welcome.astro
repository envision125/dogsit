<!-- Animated Services Section -->
<section id="features" class="py-20 bg-white">
  <div class="container mx-auto px-6">
    <h2
      class="text-3xl font-bold text-center text-sky-600 mb-4 animate-fade-in"
    >
      Our Doggy Services<span class="text-sky-300"></span>
    </h2>
    <p
      class="text-lg text-center text-pink-400 mb-16 max-w-2xl mx-auto animate-fade-in animate-delay-100"
    >
      Comprehensive care solutions tailored to your dog's needs and your
      schedule. Every service comes with complete peace of mind.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Feature 1 with animation -->
      <div
        class="bg-sky-50 p-6 rounded-xl shadow-md hover-grow transition-all duration-300 transform hover:shadow-xl animate-slide-in-left animate-delay-100"
      >
        <div
          class="bg-sky-100 p-3 rounded-full w-14 h-14 flex items-center justify-center mb-4 mx-auto animate-pulse-slow"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-8 h-8 text-sky-600"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 9.75L12 4.5l9 5.25v9a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18.75v-9z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 22.5v-6h6v6"></path>
          </svg>
          <!-- <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg> -->
        </div>
        <h3 class="text-xl font-semibold text-center mb-3">
          Dog Sitting
        </h3>
        <p class="text-gray-700 text-center">
          In-home care while you're away for work or vacation. Your pet is our
          priority.
        </p>
      </div>

      <!-- Feature 2 with animation -->
      <div
        class="bg-sky-50 p-6 rounded-xl shadow-md hover-grow transition-all duration-300 transform hover:shadow-xl animate-slide-in-left animate-delay-200"
      >
        <div
          class="bg-sky-100 p-3 rounded-full w-14 h-14 flex items-center justify-center mb-4 mx-auto animate-pulse-slow animate-delay-200"
        >
          <svg
            class="w-8 h-8 text-sky-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
