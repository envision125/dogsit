</section>

<!-- Testimonial  Section -->
<Testimonials />

<!-- Dog's Section -->
<section id="happy-clients" class="py-20 bg-gray-50">
  <div class="container mx-auto px-6">
    <h2 class="text-3xl font-bold text-center text-sky-400 mb-4">
      Happy<span class="text-pink-400"> Dogs</span>
    </h2>
    <p class="text-lg text-center text-gray-800 mb-16 max-w-2xl mx-auto">
      See the joy and love we bring to every furry friend in our care!
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Creates Card with blue background around image -->
      <!-- <div
        class="bg-sky-50 p-6 rounded-xl shadow-md hover:shadow-xl transition duration-300 transform hover:-translate-y-2"
      >
        <img
          src={Dog1.src}
          alt="Astronaut playing with dogs in a futuristic space-themed dog park"
          class="w-full h-auto rounded-lg shadow-xl"
        />
      </div> -->
      <div
        class="transition duration-300 transform hover:-translate-y-2"
      >
        <img
          src={Dog1.src}
          alt="Astronaut playing with dogs in a futuristic space-themed dog park"
          class="w-full h-auto rounded-lg shadow-xl"
        />
      </div>

      <!-- Dog 2 -->
      <div
        class="transition duration-300 transform hover:-translate-y-2"
      >
        <img
          src={Dog2.src}
          alt="Astronaut playing with dogs in a futuristic space-themed dog park"
          class="w-full h-auto rounded-lg shadow-xl"
        />
      </div>

      <!-- Dog 3 -->
      <div
        class="transition duration-300 transform hover:-translate-y-2"
      >
        <img
          src={Dog3.src}
          alt="Astronaut playing with dogs in a futuristic space-themed dog park"
          class="w-full h-auto rounded-lg shadow-xl"
        />
      </div>
      <!-- Dog 4 -->
      <div
        class="transition duration-300 transform hover:-translate-y-2"
      >
        <img
          src={Dog4.src}
          alt="Astronaut playing with dogs in a futuristic space-themed dog park"
          class="w-full h-auto rounded-lg shadow-xl"
        />
      </div>

      <!-- Dog 5 -->
      <div
        class="transition duration-300 transform hover:-translate-y-2"
      >
        <img
          src={Dog5.src}
          alt="Astronaut playing with dogs in a futuristic space-themed dog park"
          class="w-full h-auto rounded-lg shadow-xl"
        />
      </div>

      <!-- Dog 6 -->
      <div
        class="transition duration-300 transform hover:-translate-y-2"
      >
        <img
          src={Dog6.src}
